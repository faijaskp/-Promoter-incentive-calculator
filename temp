<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07140f">
<title>WARRIORS — Promoter Incentive Calculator</title>
<style>
:root{
  --bg:#f4f7f6; --card:#fff; --ink:#0b1b16; --muted:#60706b;
  --green:#079447; --green2:#0bc56b; --dark:#07140f; --gold:#f6c453;
  --line:#dfe8e3; --shadow:0 12px 34px rgba(8,35,24,.08);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,Segoe UI,sans-serif}
.hero{
  position:relative;overflow:hidden;padding:34px 18px 38px;text-align:center;color:#fff;
  background:radial-gradient(circle at 50% 20%,#185d3b 0,#0b2a1d 38%,#07140f 75%);
}
.hero:before,.hero:after{
  content:"";position:absolute;border-radius:50%;filter:blur(2px);opacity:.45;
  border:1px solid rgba(11,197,107,.45);animation:orbit 8s linear infinite;
}
.hero:before{width:460px;height:160px;left:50%;top:20px;transform:translateX(-50%) rotate(-8deg)}
.hero:after{width:650px;height:230px;left:50%;top:-20px;transform:translateX(-50%) rotate(10deg);animation-direction:reverse;animation-duration:11s}
.wrap{max-width:1120px;margin:auto;position:relative;z-index:2}
.crown{font-size:28px;animation:pulse 2.5s ease-in-out infinite}
.hero h1{
  margin:2px 0 2px;font-size:clamp(40px,8vw,76px);letter-spacing:7px;
  font-weight:900;color:var(--gold);text-shadow:0 0 18px rgba(246,196,83,.28);
  animation:glow 3.2s ease-in-out infinite;
}
.hero .tag{margin:0;font-size:13px;letter-spacing:5px;color:#dff8ea}
.hero .motto{margin:16px 0 0;color:#a9f0c9;font-weight:700;letter-spacing:2px}
.hero .line{width:170px;height:3px;margin:18px auto 0;background:linear-gradient(90deg,transparent,#21dc82,transparent);animation:shine 2.4s ease-in-out infinite}
main{padding:22px 16px 34px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:var(--shadow);margin-bottom:18px}
.card h2{margin:0 0 5px;font-size:20px}
.sub{margin:0 0 18px;color:var(--muted);font-size:14px}
.controls{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.field{padding:14px;border:1px solid var(--line);border-radius:13px;background:#fbfdfc}
.field label{display:block;font-size:12px;font-weight:800;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px}
select{width:100%;padding:11px 12px;border:1px solid #cfdad5;border-radius:10px;background:#fff;color:var(--ink);font-size:15px;font-weight:700}
.results{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.result{border:1px solid var(--line);border-radius:14px;padding:15px;background:#f9fbfa}
.result .k{font-size:12px;color:var(--muted);font-weight:800}
.result .v{margin-top:6px;font-size:22px;font-weight:900}
.total{background:linear-gradient(135deg,#e9fff2,#f8fff9);border-color:#91ddb5}
.total .v{color:var(--green);font-size:27px}
.actions{display:flex;gap:10px;justify-content:flex-end;margin-top:15px}
button{border:0;border-radius:10px;padding:10px 15px;font-weight:800;cursor:pointer}
.reset{background:#e7f6ee;color:#08773e}
.note{font-size:12px;color:var(--muted);line-height:1.55;margin:14px 0 0}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;max-height:520px}
table{border-collapse:collapse;width:100%;min-width:820px;font-size:13px}
th,td{padding:11px 12px;border-bottom:1px solid var(--line);text-align:right}
th{position:sticky;top:0;background:#10271e;color:#fff;text-align:right}
th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}
tbody tr:hover{background:#f1faf5}
.money{font-weight:800}
footer{background:var(--dark);color:#c9dfd4;padding:18px;text-align:center;font-size:12px;letter-spacing:2px}
@keyframes glow{0%,100%{text-shadow:0 0 8px rgba(246,196,83,.15)}50%{text-shadow:0 0 24px rgba(246,196,83,.55)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
@keyframes orbit{0%{transform:translateX(-50%) rotate(0deg)}100%{transform:translateX(-50%) rotate(360deg)}}
@keyframes shine{0%,100%{opacity:.35;transform:scaleX(.7)}50%{opacity:1;transform:scaleX(1)}}
@media(max-width:900px){.controls{grid-template-columns:repeat(2,1fr)}.results{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.controls,.results{grid-template-columns:1fr}.hero h1{letter-spacing:3px}.hero{padding-top:28px}}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <div class="crown">♛</div>
    <h1>WARRIORS</h1>
    <p class="tag">SELL&nbsp;&nbsp; • &nbsp;&nbsp;ACHIEVE&nbsp;&nbsp; • &nbsp;&nbsp;EARN&nbsp;&nbsp; • &nbsp;&nbsp;GROW</p>
    <p class="motto">ONE TEAM • BIGGER GOALS • BIGGER REWARDS</p>
    <div class="line"></div>
  </div>
</header>

<main class="wrap">
<section class="card">
  <h2>Incentive Calculator</h2>
  <p class="sub">Select the plan and eligibility to calculate the applicable payout.</p>
  <div class="controls">
    <div class="field"><label>MRC / Plan</label><select id="mrc"></select></div>
    <div class="field"><label>Activation Type</label><select id="type"><option>MNP</option><option>New</option><option>P2P</option></select></div>
    <div class="field"><label>Tactical 100% Eligible?</label><select id="tactical"><option>Yes</option><option>No</option></select></div>
    <div class="field"><label>Daily Pay Eligible?</label><select id="daily"><option>Yes</option><option>No</option></select></div>
  </div>
  <div class="actions"><button class="reset" id="reset">↻ Reset</button></div>
</section>

<section class="card">
  <h2>Incentive Breakdown</h2>
  <p class="sub">Live calculation based on your selections.</p>
  <div class="results">
    <div class="result"><div class="k">NORMAL INCENTIVE</div><div class="v" id="normal">AED 0</div></div>
    <div class="result"><div class="k">TACTICAL 100%</div><div class="v" id="tact">AED 0</div></div>
    <div class="result"><div class="k">TACTICAL ADDITIONAL</div><div class="v" id="add">AED 0</div></div>
    <div class="result"><div class="k">ETISALAT BASIC</div><div class="v" id="basic">AED 0</div></div>
    <div class="result"><div class="k">ETISALAT PER DAY</div><div class="v" id="day">AED 0</div></div>
  </div>
  <div class="result total" style="margin-top:12px">
    <div class="k">TOTAL APPLICABLE</div><div class="v" id="total">AED 0</div>
  </div>
  <p class="note">Tactical Additional applies only to MNP/New. P2P Tactical Additional is AED 0. Daily Pay is shown only when Daily Pay eligibility is Yes.</p>
</section>

<section class="card">
  <h2>Quick Reference</h2>
  <p class="sub">All MRC × activation combinations from the rate card.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>MRC / Plan</th><th>Activation</th><th>Normal Incentive</th><th>Tactical 100%</th><th>Tactical Additional</th><th>Etisalat Basic</th><th>Etisalat Per Day</th></tr></thead>
      <tbody id="ref"></tbody>
    </table>
  </div>
</section>
</main>

<footer>WARRIORS NEVER STOP • DISCIPLINE TODAY • REWARDS TOMORROW</footer>

<script>
const DATA={"375":{"MNP":{"normal":150,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":150,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":100,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"325":{"MNP":{"normal":125,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":125,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":90,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"400":{"MNP":{"normal":150,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":150,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":100,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"500":{"MNP":{"normal":175,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":175,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":125,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"600":{"MNP":{"normal":225,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":225,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":175,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"1000":{"MNP":{"normal":325,"tactical":50,"additional":15,"etisalat":50,"daily":25},"New":{"normal":325,"tactical":40,"additional":15,"etisalat":30,"daily":15},"P2P":{"normal":275,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"200":{"MNP":{"normal":60,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":60,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":40,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"225":{"MNP":{"normal":60,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":60,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":50,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"250":{"MNP":{"normal":100,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":100,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":50,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"260":{"MNP":{"normal":100,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":100,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":60,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"125":{"MNP":{"normal":25,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":25,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":15,"tactical":25,"additional":0,"etisalat":15,"daily":10}},"175":{"MNP":{"normal":25,"tactical":50,"additional":0,"etisalat":50,"daily":25},"New":{"normal":25,"tactical":40,"additional":0,"etisalat":30,"daily":15},"P2P":{"normal":15,"tactical":25,"additional":0,"etisalat":15,"daily":10}}};
const ORDER=[375, 325, 400, 500, 600, 1000, 200, 225, 250, 260, 125, 175];
const money=n=>'AED '+Number(n).toLocaleString('en-AE');
const el=id=>document.getElementById(id);

ORDER.forEach(m=>{
  const o=document.createElement('option');
  o.value=m;o.textContent=m;
  el('mrc').appendChild(o);
});
el('mrc').value=325;

function calculate(){
  const x=DATA[String(el('mrc').value)][el('type').value];
  const tactical=el('tactical').value==='Yes';
  const daily=el('daily').value==='Yes';
  const normal=x.normal;
  const tact=tactical?x.tactical:0;
  const additional=tactical?x.additional:0;
  const basic=x.etisalat;
  const day=daily?x.daily:0;
  const total=normal+tact+additional+basic+day;
  el('normal').textContent=money(normal);
  el('tact').textContent=money(tact);
  el('add').textContent=money(additional);
  el('basic').textContent=money(basic);
  el('day').textContent=money(day);
  el('total').textContent=money(total);
}
['mrc','type','tactical','daily'].forEach(id=>el(id).addEventListener('change',calculate));

el('reset').addEventListener('click',()=>{
  el('mrc').value=325;el('type').value='MNP';el('tactical').value='Yes';el('daily').value='Yes';calculate();
});

let ref='';
ORDER.forEach(m=>{
  ['MNP','New','P2P'].forEach(t=>{
    const x=DATA[String(m)][t];
    ref+=`<tr><td>${m}</td><td>${t}</td><td class="money">${money(x.normal)}</td><td class="money">${money(x.tactical)}</td><td class="money">${money(x.additional)}</td><td class="money">${money(x.etisalat)}</td><td class="money">${money(x.daily)}</td></tr>`;
  });
});
el('ref').innerHTML=ref;
calculate();
</script>
</body>
</html>
